        "triggerCondition": "ON_COUNTER_CHANGED",
        "sharedPerEvent": true,
        "trigger": {
          "subject": "any",
          "controller": "self",
          "condition": {
            "all": [
              {
                "op": "eq",
                "left": {
                  "path": "event.payload.counterType"
                },
                "right": "scorch"
              },
              {
                "op": "gt",
                "left": {
                  "path": "event.payload.amount"
                },
                "right": 0
              }
            ]
          }
        },
        "effect": {
          "family": "cards",
          "operation": "draw",
          "params": {
            "amount": 1
          },
          "targeting": {
            "type": "self",
            "required": false
          }
        }
      }
    ]
  },

