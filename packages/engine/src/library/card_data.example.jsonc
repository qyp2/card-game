            "damage"
          ],
          "targeting": {
            "type": "permanent",
            "controller": "opponent",
            "cardTypes": [
              "Creature"
            ],
            "required": true,
            "minTargets": 1,
            "maxTargets": 1
          }
        }
      },
      {
        "id": "death-draw",
        "type": "triggered",
        "triggerCondition": "ON_DIE",
        "trigger": {
          "subject": "self"
        },
        "effect": {
          "family": "cards",
          "operation": "draw",
          "params": {
            "amount": 1
          }
        }
      },
      {
        "id": "watch-other-entry",
