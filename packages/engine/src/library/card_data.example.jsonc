  "example-announced-x": {
    "schemaVersion": 1,
    "id": "example-announced-x",
    "name": "Example X drain",
    "cardTypes": [
      "Spell"
    ],
    "rulesText": "Choose X (0–4). Pay X energy or 2 life, plus one red and discard a card. Opponent loses X life.",
    "numericDeclarations": [
      {
        "name": "X",
        "min": 0,
        "max": 4
      }
    ],
    "castRequirements": {
      "speed": "sorcery",
      "allowedZones": [
        "hand"
      ],
      "cost": {
        "mana": {
          "generic": {
            "numeric": {
              "kind": "binding",
              "name": "X"
            }
          }
        }
      },
      "alternativeCosts": [
        {
          "id": "life",
          "label": "Pay 2 life",
          "cost": {
            "life": 2
          }
        }
      ],
      "additionalCost": {
        "mana": {
          "red": 1
        },
        "discard": 1
      }
    },
    "onCastEffects": [
      {
        "family": "resources",
        "operation": "adjust_life",
        "params": {
          "amount": {
            "numeric": {
              "kind": "multiply",
              "left": -1,
              "right": {
                "numeric": {
                  "kind": "binding",
                  "name": "X"
                }
              }
            }
          }
        },
        "targeting": {
          "type": "player",
          "controller": "opponent",
          "required": true,
          "minTargets": 1,
          "maxTargets": 1
        }
      }
    ]
  },

