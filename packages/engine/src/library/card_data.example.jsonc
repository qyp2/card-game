{
  "example-mill-result": {
    "schemaVersion": 1,
    "id": "example-mill-result",
    "name": "Mill, count and recover from this mill",
    "cardTypes": ["Spell"],
    "onCastEffects": [
      {
        "family": "cards", "operation": "mill", "params": { "amount": 3 },
        "recordResult": { "name": "milled", "kind": "milled" }
      },
      {
        "family": "resources", "operation": "adjust_life",
        "params": { "amount": { "numeric": { "kind": "query", "id": "count", "args": {
          "scope": { "from": { "kind": "result", "name": "milled", "view": "recorded" }, "zones": ["graveyard"], "cardTypes": ["Creature"] }
        } } } }
      },
      {
        "family": "cards", "operation": "move", "params": { "origin": "graveyard", "destination": "hand" },
        "choice": { "kind": "search", "zone": "graveyard", "from": { "kind": "result", "name": "milled" },
          "cardTypes": ["Creature"], "colors": ["black"], "min": 1, "max": 1 }
      }
    ]
  },
